static func get_item(item_id: int) -> Dictionary:
	return ITEMS.get(item_id, {})

static func get_item_by_name(item_name: String) -> Dictionary:
	for k in ITEMS.keys():
		if ITEMS[k].get("name", "") == item_name:
			return ITEMS[k]
	return {}
