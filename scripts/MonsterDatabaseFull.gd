static var _cached_by_id: Dictionary = {}
static var _cached_by_level: Dictionary = {}

static func _init_cache():
	if not _cached_by_id.is_empty():
		return
	for m in MONSTERS:
		_cached_by_id[m.id] = m
		var lvl = m.level
		if not _cached_by_level.has(lvl):
			_cached_by_level[lvl] = []
		_cached_by_level[lvl].append(m)

static func get_monster(id: int) -> Dictionary:
	_init_cache()
	if _cached_by_id.has(id):
		return _cached_by_id[id]
	if not MONSTERS.is_empty():
		return MONSTERS[0]
	return {}

static func get_monsters_for_level(lvl: int) -> Array:
	_init_cache()
	if _cached_by_level.has(lvl):
		return _cached_by_level[lvl]
	var closest_diff = 9999
	var best_list = []
	for l in _cached_by_level.keys():
		var diff = abs(l - lvl)
		if diff < closest_diff:
			closest_diff = diff
			best_list = _cached_by_level[l]
	return best_list

static func get_random_monster_for_wave(wave_num: int) -> Dictionary:
	_init_cache()
	var target_lvl = int(1 + (wave_num - 1) * 3.2)
	var min_lvl = max(1, target_lvl - 4)
	var max_lvl = target_lvl + 4
	
	var candidates = []
	for m in MONSTERS:
		if m.level >= min_lvl and m.level <= max_lvl:
			candidates.append(m)
			
	if candidates.is_empty():
		return get_monster((wave_num * 5) % max(1, MONSTERS.size()) + 1)
		
	return candidates[randi() % candidates.size()]

static func get_boss_monster_for_wave(wave_num: int) -> Dictionary:
	_init_cache()
	var target_lvl = int(5 + wave_num * 3.5)
	var bosses = []
	for m in MONSTERS:
		if m.get("is_boss", false) and m.level >= target_lvl - 15 and m.level <= target_lvl + 20:
			bosses.append(m)
			
	if not bosses.is_empty():
		return bosses[randi() % bosses.size()]
	return get_random_monster_for_wave(wave_num)

static var FULL_DATABASE: Dictionary = _build_full_database()

static func _build_full_database() -> Dictionary:
	var dict = {}
	for m in MONSTERS:
		dict[m.id] = m
	return dict

static func get_wave_data(wave_num: int) -> Dictionary:
	var normal_mob = get_random_monster_for_wave(wave_num)
	var data = {
		"monster_id": normal_mob.id,
		"count": 6 + int(wave_num * 0.4)
	}
	if wave_num % 5 == 0:
		var boss_mob = get_boss_monster_for_wave(wave_num)
		data["boss_id"] = boss_mob.id
	return data

