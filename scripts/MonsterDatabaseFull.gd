static var _lookup_cache: Dictionary = {}
static var _boss_cache: Array[Dictionary] = []

static func _build_cache():
	if _lookup_cache.is_empty():
		for m in MONSTERS:
			_lookup_cache[m.id] = m
			if m.get("is_boss", false):
				_boss_cache.append(m)

static func get_monster(mob_id: int) -> Dictionary:
	_build_cache()
	if _lookup_cache.has(mob_id):
		return _lookup_cache[mob_id]
	if not MONSTERS.is_empty():
		return MONSTERS[0]
	return {}

static func get_all_bosses() -> Array[Dictionary]:
	_build_cache()
	return _boss_cache

static func get_wave_data(wave: int) -> Dictionary:
	_build_cache()
	var mob_count = min(35, 12 + int(wave * 0.6))
	
	var target_lvl = clamp(wave * 2, 1, 140)
	var chosen_mob_id = 100100
	var min_diff = 999
	for m in MONSTERS:
		if not m.get("is_boss", false):
			var diff = abs(m.level - target_lvl)
			if diff < min_diff:
				min_diff = diff
				chosen_mob_id = m.id
				
	var res = {
		"wave": wave,
		"count": mob_count,
		"monster_id": chosen_mob_id
	}
	
	if wave % 5 == 0:
		var boss_candidates = get_all_bosses()
		if not boss_candidates.is_empty():
			var chosen_boss = boss_candidates[0]
			var min_b_diff = 999
			for b in boss_candidates:
				var b_diff = abs(b.level - (wave * 2.2))
				if b_diff < min_b_diff:
					min_b_diff = b_diff
					chosen_boss = b
			res["boss_id"] = chosen_boss.id
			
	return res
