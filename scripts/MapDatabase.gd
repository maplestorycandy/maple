static func get_map(map_id: String) -> Dictionary:
	return MAPS.get(map_id, MAPS["100000000"])

static func get_all_maps() -> Array:
	var list = []
	for k in MAPS.keys():
		list.append(MAPS[k])
	return list

static func get_map_monsters(map_id: String) -> Array:
	var m = get_map(map_id)
	return m.get("monsters", [])
