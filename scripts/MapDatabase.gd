static var _map_list_cache: Array[Dictionary] = []

static func get_map_list() -> Array[Dictionary]:
	if not _map_list_cache.is_empty():
		return _map_list_cache
	for mid in MAPS.keys():
		var m = MAPS[mid]
		_map_list_cache.append({
			"id": mid,
			"name": m.name,
			"street": m.street,
			"region": m.region,
			"terrain_theme": m.get("terrain_theme", "henesys"),
			"description": "%s (%s) | 怪物種類: %d | NPC: %d" % [m.street, m.region, m.monsters.size(), m.npcs.size()],
			"is_town": m.is_town,
			"monsters": m.monsters,
			"npcs": m.npcs,
			"normal_portals": m.normal_portals,
			"hidden_portals": m.hidden_portals
		})
	return _map_list_cache

static func get_map_info(map_id: String) -> Dictionary:
	if MAPS.has(map_id):
		return MAPS[map_id]
	if MAPS.has("100000000"):
		return MAPS["100000000"]
	return {}
